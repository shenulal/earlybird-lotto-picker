{
  "appSettings": {
    "totalPrizes": 50,
    "eventName": "Annual Gala Raffle",
    "organizationName": "Example Organisation",
    "locale": "en",
    "direction": "ltr",
    "data": {
      "identifier": "badge_id",
      "duplicatePolicy": "skip",
      "fields": [
        {
          "key": "badge_id",
          "label": "Badge ID",
          "sensitive": false,
          "includeInExport": true
        },
        {
          "key": "guest_name",
          "label": "Guest Name",
          "sensitive": false,
          "includeInExport": true
        },
        {
          "key": "company",
          "label": "Company",
          "sensitive": false,
          "includeInExport": true
        },
        {
          "key": "table",
          "label": "Table",
          "sensitive": false,
          "includeInExport": true
        },
        {
          "key": "mobile_number",
          "label": "Mobile Number",
          "sensitive": true,
          "includeInExport": true
        }
      ]
    },
    "display": {
      "reel": {
        "lines": [
          {
            "field": "badge_id",
            "emphasis": "primary",
            "showLabel": false
          }
        ]
      },
      "call": {
        "lines": [
          {
            "field": "badge_id",
            "emphasis": "primary",
            "showLabel": false
          }
        ]
      },
      "card": {
        "lines": [
          {
            "field": "guest_name",
            "emphasis": "primary",
            "showLabel": false
          },
          {
            "field": "badge_id",
            "emphasis": "secondary",
            "showLabel": false
          },
          {
            "field": "company",
            "emphasis": "meta",
            "showLabel": false
          },
          {
            "field": "table",
            "emphasis": "meta",
            "showLabel": true
          }
        ]
      },
      "panel": {
        "lines": [
          {
            "field": "badge_id",
            "emphasis": "eyebrow",
            "showLabel": false
          },
          {
            "field": "guest_name",
            "emphasis": "primary",
            "showLabel": false
          },
          {
            "field": "company",
            "emphasis": "meta",
            "showLabel": false
          }
        ],
        "maxEntries": 50
      },
      "autoStopWhenPrizesExhausted": true
    },
    "animation": {
      "rollingSpeed": 60,
      "confettiDuration": 7000,
      "confettiCount": 200,
      "confettiPalette": [
        "#ffd54f",
        "#ff8a65",
        "#4dd0e1",
        "#f06292",
        "#aed581",
        "#ffffff"
      ],
      "winnerAnnouncementDelay": 2500,
      "confettiStartDelay": 500
    },
    "draw": {
      "publicDrawEnabled": true,
      "requireAuthForDraw": false,
      "minimumRollMs": 1200
    },
    "branding": {
      "logo": {
        "src": "",
        "position": "top-left",
        "maxHeight": 96,
        "width": null,
        "height": null
      },
      "background": {
        "src": "Background.png",
        "fit": "cover",
        "overlayOpacity": 45,
        "width": null,
        "height": null
      }
    },
    "copy": {
      "readyTitle": "Ready to draw",
      "readyDetail": "Press Start",
      "winnerEyebrow": "Winner",
      "prizeLabel": "Prize",
      "lastWinnerEyebrow": "Last winner",
      "completeTitle": "All prizes awarded",
      "startButton": "Start",
      "stopButton": "Stop",
      "winnersHeading": "Winners",
      "winnersEmpty": "No draws yet.",
      "winnersToggle": "Winners",
      "fullscreenButton": "Fullscreen",
      "organiserLink": "Organiser",
      "footer": "",
      "loading": "Preparing the draw…"
    },
    "ui": {
      "primaryColor": "#00e676",
      "backgroundColor": "radial-gradient(circle at top, #0d47a1, #1976d2)",
      "showOrganizationName": true,
      "showWinnersPanel": true,
      "showStats": true,
      "boardAlignment": "center"
    },
    "welcome": {
      "enabled": true,
      "showOnLoad": true,
      "placement": "overlay",
      "title": "Our chief guest",
      "message": "Please join us in welcoming\nH.E. Dr. Amina Al Suwaidi",
      "showCaptions": true,
      "intervalMs": 5000,
      "images": [
        {
          "src": "assets/guest-0a1b2c3d4e.jpg",
          "caption": "H.E. Dr. Amina Al Suwaidi",
          "width": 1200,
          "height": 1500
        }
      ]
    }
  }
}
