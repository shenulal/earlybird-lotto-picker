# Copy to deploy/tenants/<tenant>.env and fill in. One file per event.

# Lower-case letters, digits and hyphens. Shown at /api/health so you can check
# a domain reaches the event it should.
PICKORA_TENANT=alpha

# The organiser console sign-in. Required: without both, the container refuses
# to start rather than come up on the published default password.
ADMIN_USERNAME=organiser
ADMIN_PASSWORD=change-me-to-something-long

# Recommended — a different random value per tenant, e.g. `openssl rand -hex 32`.
# Unset, the key is derived from the password, so two tenants sharing a password
# would also share a signing key.
# SESSION_SECRET=
